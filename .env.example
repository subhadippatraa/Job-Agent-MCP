# =============================================================================
# Job Search Agent — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# PostgreSQL (production)
DATABASE_URL=postgresql+asyncpg://jobagent:jobagent@localhost:5432/jobagent

# SQLite fallback (development) — uncomment to use instead of PostgreSQL
# DATABASE_URL=sqlite+aiosqlite:///./jobagent.db

# -----------------------------------------------------------------------------
# Candidate Profile
# -----------------------------------------------------------------------------
CANDIDATE_PROFILE_PATH=profile/candidate.yaml
RESUME_PATH=resume/master_resume.pdf

# -----------------------------------------------------------------------------
# Job Search Defaults
# -----------------------------------------------------------------------------
DEFAULT_SEARCH_LIMIT=50
DEFAULT_POSTED_WITHIN_HOURS=24
HTTP_TIMEOUT_SECONDS=30
MAX_RETRIES=3

# -----------------------------------------------------------------------------
# Provider Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of company board tokens for Greenhouse
# Example: GREENHOUSE_BOARDS=stripe,figma,anthropic,openai
GREENHOUSE_BOARDS=

# Comma-separated list of company slugs for Lever
# Example: LEVER_COMPANIES=openai,anthropic,databricks
LEVER_COMPANIES=

# Comma-separated list of job board names for Ashby
# Example: ASHBY_BOARDS=anthropic,descript
ASHBY_BOARDS=

# -----------------------------------------------------------------------------
# LLM Configuration (Optional — core features work without these)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# LLM_PROVIDER=openai  # or "anthropic" or "none"

# -----------------------------------------------------------------------------
# Matching Configuration
# -----------------------------------------------------------------------------
MATCH_WEIGHT_REQUIRED_SKILLS=0.35
MATCH_WEIGHT_EXPERIENCE=0.20
MATCH_WEIGHT_ROLE_SIMILARITY=0.15
MATCH_WEIGHT_PREFERRED_SKILLS=0.10
MATCH_WEIGHT_LOCATION=0.10
MATCH_WEIGHT_DOMAIN=0.10

# Minimum score to auto-shortlist (0-100)
AUTO_SHORTLIST_MIN_SCORE=75

# -----------------------------------------------------------------------------
# Safety — Application Submission
# -----------------------------------------------------------------------------
# When true (default), record_application requires explicit user_confirmed=true.
# The agent will NEVER auto-submit applications without human approval.
# Set to false ONLY if you have an external pipeline that handles approval.
REQUIRE_HUMAN_APPROVAL=true

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
